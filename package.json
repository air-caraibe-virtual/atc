{
  "name": "atc-solo",
  "productName": "ATC",
  "version": "0.2.3-test.7",
  "description": "ATC — contrôle aérien vocal pour Microsoft Flight Simulator 2024",
  "main": "main.js",
  "author": "ATC",
  "license": "UNLICENSED",
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "leaflet": "^1.9.4",
    "msedge-tts": "^2.1.1",
    "node-simconnect": "^4.0.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/flight.test.js",
    "dist": "bash build/make.sh"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "fr.atcsolo.app",
    "productName": "ATC",
    "files": [
      "main.js",
      "preload.js",
      "stt.js",
      "llm.js",
      "src/**/*",
      "package.json",
      "build/icon.png",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/@huggingface/transformers/dist/*.map",
      "!node_modules/@huggingface/transformers/dist/transformers.{js,min.js,web.js,web.min.js}",
      "!node_modules/@huggingface/transformers/dist/ort-wasm*",
      "!node_modules/@huggingface/transformers/src/**"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "legalTrademarks": "",
      "publisherName": "ATC"
    },
    "copyright": "© 2026 ATC",
    "directories": {
      "buildResources": "build"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ]
  }
}
